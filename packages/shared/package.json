{
  "name": "@retainer/shared",
  "version": "0.1.0",
  "description": "Shared types for Retainer: field types, composite value shapes, actors and schema definitions.",
  "keywords": [
    "retainer",
    "crm",
    "ai-agents",
    "memory"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Tamloot-cc/Retainer/tree/main/packages/shared#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tamloot-cc/Retainer.git",
    "directory": "packages/shared"
  },
  "bugs": "https://github.com/Tamloot-cc/Retainer/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
