{
  "name": "@retainer/server",
  "version": "0.0.0",
  "private": true,
  "description": "Retainer server: REST API, MCP endpoint, workers and schema engine.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@retainer/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "libphonenumber-js": "^1.13.15",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
