# SurrealDB 4.0.0 (docker/compose.yml pins the tested digest)
RETAINER_SURREAL_URL=http://127.0.0.1:8000
RETAINER_SURREAL_NAMESPACE=retainer
# The system user: definitions and provisioning only. Runtime sessions use
# record-access tokens signed with RETAINER_SIGNING_KEY.
RETAINER_SURREAL_USER=root
RETAINER_SURREAL_PASS=retainer
# root, or namespace for a namespace-scoped system user
# RETAINER_SURREAL_AUTH_LEVEL=root

# Host port for SurrealDB in docker/compose.yml (change if 8000 is taken)
RETAINER_SURREAL_PORT=8000

# Signs runtime database sessions. Generate with: pnpm retainer signing-key generate
# To rotate: set the new key here, move the old value to the previous keys
# (comma-separated) until every workspace is upgraded, then drop it. List the
# IDs of compromised keys as revoked to remove them on the next boot.
RETAINER_SIGNING_KEY=
# RETAINER_SIGNING_PREVIOUS_KEYS=
# RETAINER_SIGNING_REVOKED_KEY_IDS=

PORT=8787
LOG_LEVEL=info

# How long a write waits for its workspace's queue before workspace_busy (ms).
# RETAINER_WRITE_QUEUE_LIMIT_MS=10000

# Optional: absolute path to packages/web/dist when serving the built UI locally.
# The Docker image sets this automatically. Leave unset when using pnpm dev:web.
# RETAINER_WEB_DIR=/absolute/path/to/Retainer/packages/web/dist

# Required when TLS terminates at a reverse proxy; use the browser-facing origin.
# RETAINER_PUBLIC_ORIGIN=https://retainer.example

# Required for forget: secret for the HMAC of erased emails, phones and event
# identities (32+ characters, e.g. `openssl rand -hex 32`). Keep it stable. To
# rotate it, set the new key here and list the old ones below, comma-separated:
# they are still checked, so erased handles and events stay suppressed.
# RETAINER_SUPPRESSION_KEY=
# RETAINER_SUPPRESSION_PREVIOUS_KEYS=

# How often the consolidator runs per workspace, in minutes.
# RETAINER_CONSOLIDATE_INTERVAL_MINUTES=60
