# Postgres 17
DATABASE_URL=postgres://retainer:retainer@localhost:5432/retainer

# api | worker | all
RETAINER_ROLE=all
PORT=8787
LOG_LEVEL=info

# Host port for Postgres in docker/compose.yml (change if 5432 is taken)
RETAINER_PG_PORT=5432

# Optional: absolute path to packages/web/dist when serving the built UI locally.
# The Docker image sets this automatically. Leave unset when using pnpm dev:web.
# RETAINER_WEB_DIR=/absolute/path/to/Retainer/packages/web/dist

# Required when TLS terminates at a reverse proxy; use the browser-facing origin.
# RETAINER_PUBLIC_ORIGIN=https://retainer.example

# Required for forget: secret for the HMAC of erased emails and phones (32+
# characters, e.g. `openssl rand -hex 32`). Keep it stable; a new key lets
# erased handles back in.
# RETAINER_SUPPRESSION_KEY=

# How often the consolidator runs per workspace, in minutes.
# RETAINER_CONSOLIDATE_INTERVAL_MINUTES=60
